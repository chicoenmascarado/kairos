<Window x:Class="KairosSpot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KaiSpot"
        Width="620" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Paleta Kairos -->
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F4FF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9999BB"/>
        <SolidColorBrush x:Key="Accent" Color="#5B5BF5"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#A78BFA"/>

        <Style x:Key="ResultText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <!-- Contenedor glass: el acrylic lo pone el SO por debajo; este Border
         aporta el tinte Kairos translucido, las esquinas y la sombra. -->
    <Border x:Name="Root"
            Background="#33141422"
            CornerRadius="18"
            BorderBrush="#26A78BFA" BorderThickness="1"
            Margin="18"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="44" ShadowDepth="10" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <StackPanel>
            <!-- Caja de busqueda -->
            <Grid Margin="22,18,22,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE721;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="17" Foreground="#B3A78BFA"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBox x:Name="Input" Grid.Column="1"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextPrimary}"
                         CaretBrush="{StaticResource AccentSoft}"
                         FontFamily="Inter, Segoe UI" FontWeight="Light"
                         FontSize="18" VerticalAlignment="Center"
                         TextChanged="Input_TextChanged"
                         PreviewKeyDown="Input_PreviewKeyDown"/>
            </Grid>

            <!-- Separador hairline -->
            <Border x:Name="Divider" Height="0.5" Background="#10FFFFFF"/>

            <!-- Lista de resultados -->
            <ListBox x:Name="Results"
                     Background="Transparent" BorderThickness="0"
                     Padding="6" MaxHeight="420"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     KeyboardNavigation.DirectionalNavigation="Contained"
                     MouseDoubleClick="Results_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="4,2"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="13" Padding="12,10"
                                            Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2E5B5BF5"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1A5B5BF5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icono: real si existe, glifo glass si no -->
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                                    Background="#0DFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="0.5"
                                    Margin="0,0,14,0">
                                <Grid>
                                    <Image Source="{Binding Icon}" Width="20" Height="20"
                                           Visibility="{Binding IconVisibility}"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding Glyph}"
                                               Visibility="{Binding GlyphVisibility}"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16" Foreground="#D9F4F4FF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource ResultText}"/>
                                <TextBlock Text="{Binding Subtitle}"
                                           Foreground="{StaticResource TextMuted}"
                                           FontFamily="Inter, Segoe UI" FontWeight="Light"
                                           FontSize="11" Margin="0,1,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="&#x21B5;"
                                       Foreground="#4D5B5BF5" FontSize="13"
                                       VerticalAlignment="Center" Margin="8,0,2,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</Window>
