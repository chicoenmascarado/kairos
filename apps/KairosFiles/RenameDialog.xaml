<Window x:Class="KairosFiles.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renombrar"
        Width="380" Height="170"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Border Background="#E60D0D1A" CornerRadius="14"
            BorderBrush="#26A78BFA" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <StackPanel Margin="20">
            <TextBlock Text="Nuevo nombre" Foreground="#9999BB"
                       FontFamily="Inter, Segoe UI" FontSize="12" FontWeight="SemiBold"
                       Margin="2,0,0,10"/>
            <Border Background="#1AFFFFFF" CornerRadius="10"
                    BorderBrush="#1FFFFFFF" BorderThickness="0.5" Padding="12,8">
                <TextBox x:Name="NameInput" Background="Transparent" BorderThickness="0"
                         Foreground="#F4F4FF" CaretBrush="#A78BFA"
                         FontFamily="Inter, Segoe UI" FontSize="14"
                         KeyDown="NameInput_KeyDown"/>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancelar" Click="Cancel_Click" Width="90" Height="34" Margin="0,0,10,0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" CornerRadius="9" Background="#14FFFFFF">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="#D9F4F4FF"
                                           FontFamily="Inter, Segoe UI" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="Background" Value="#1F5B5BF5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Renombrar" Click="Ok_Click" Width="100" Height="34" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" CornerRadius="9" Background="#5B5BF5">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="#FFFFFF"
                                           FontFamily="Inter, Segoe UI" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="Background" Value="#6E6EF7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
