<Window x:Class="KairosFiles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KairosFiles"
        Width="980" Height="640"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F4FF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9999BB"/>
        <SolidColorBrush x:Key="Accent" Color="#5B5BF5"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#A78BFA"/>

        <!-- Scrollbar fina estilo Kairos -->
        <Style x:Key="KairosScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" CornerRadius="3" Background="#4DA78BFA" Margin="2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="Background" Value="#80A78BFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KairosScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource KairosScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boton de barra (iconos navegacion) -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#D9F4F4FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="9" Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1F5B5BF5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#4D9999BB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root"
            Background="#33141422"
            CornerRadius="16"
            BorderBrush="#26A78BFA" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Barra de titulo + navegacion ===== -->
            <Grid Grid.Row="0" Height="56" Margin="12,8,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navegacion -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackBtn" Style="{StaticResource NavButton}" Content="&#xE72B;" Click="Back_Click" ToolTip="Atras"/>
                    <Button x:Name="FwdBtn" Style="{StaticResource NavButton}" Content="&#xE72A;" Click="Forward_Click" ToolTip="Adelante"/>
                    <Button x:Name="UpBtn" Style="{StaticResource NavButton}" Content="&#xE70E;" Click="Up_Click" ToolTip="Subir"/>
                </StackPanel>

                <!-- Barra de ruta -->
                <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="10"
                        BorderBrush="#1FFFFFFF" BorderThickness="0.5"
                        Margin="10,0" Padding="12,0" VerticalAlignment="Center" Height="36">
                    <TextBox x:Name="PathBox" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextPrimary}"
                             CaretBrush="{StaticResource AccentSoft}"
                             FontFamily="Inter, Segoe UI" FontSize="13"
                             VerticalAlignment="Center"
                             KeyDown="PathBox_KeyDown"/>
                </Border>

                <!-- Busqueda -->
                <Border Grid.Column="2" Background="#1AFFFFFF" CornerRadius="10"
                        BorderBrush="#1FFFFFFF" BorderThickness="0.5"
                        Width="200" Padding="10,0" VerticalAlignment="Center" Height="36">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13" Foreground="#B3A78BFA"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimary}"
                                 CaretBrush="{StaticResource AccentSoft}"
                                 FontFamily="Inter, Segoe UI" FontSize="13"
                                 VerticalAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>

                <!-- Cerrar -->
                <Button Grid.Column="3" Style="{StaticResource NavButton}" Content="&#xE8BB;"
                        Click="Close_Click" ToolTip="Cerrar" Margin="6,0,0,0"/>
            </Grid>

            <!-- ===== Cuerpo: sidebar + lista ===== -->
            <Grid Grid.Row="1" Margin="12,4,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar accesos rapidos -->
                <Border Grid.Column="0" Background="#14FFFFFF" CornerRadius="12" Margin="0,0,8,0">
                    <StackPanel x:Name="Sidebar" Margin="8,12"/>
                </Border>

                <!-- Lista de archivos -->
                <Border Grid.Column="1" Background="#0DFFFFFF" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Cabecera de columnas -->
                        <Grid Grid.Row="0" Margin="16,12,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Nombre" Foreground="{StaticResource TextMuted}" FontFamily="Inter, Segoe UI" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Modificado" Foreground="{StaticResource TextMuted}" FontFamily="Inter, Segoe UI" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Tamano" Foreground="{StaticResource TextMuted}" FontFamily="Inter, Segoe UI" FontSize="11" FontWeight="SemiBold"/>
                        </Grid>

                        <ListBox x:Name="FileList" Grid.Row="1"
                                 Background="Transparent" BorderThickness="0"
                                 Margin="6,0,6,6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="FileList_MouseDoubleClick"
                                 KeyDown="FileList_KeyDown">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource KairosScrollBar}"/>
                            </ListBox.Resources>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Abrir" Click="Ctx_Open_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Copiar" Click="Ctx_Copy_Click"/>
                                    <MenuItem Header="Cortar" Click="Ctx_Move_Click"/>
                                    <MenuItem Header="Pegar aqui" Click="Ctx_Paste_Click"/>
                                    <MenuItem Header="Renombrar" Click="Ctx_Rename_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Eliminar (a papelera)" Click="Ctx_Delete_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" CornerRadius="9" Padding="10,7" Background="Transparent">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#2E5B5BF5"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#1A5B5BF5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Image Source="{Binding Icon}" Width="22" Height="22"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}"
                                                       FontFamily="Inter, Segoe UI" FontSize="13"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ModifiedLabel}" Foreground="{StaticResource TextMuted}"
                                                   FontFamily="Inter, Segoe UI" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeLabel}" Foreground="{StaticResource TextMuted}"
                                                   FontFamily="Inter, Segoe UI" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
