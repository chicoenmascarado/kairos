<Window x:Class="KairosMenu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KairosMenu"
        Width="560" Height="640"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F4FF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9999BB"/>
        <SolidColorBrush x:Key="Accent" Color="#5B5BF5"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#A78BFA"/>

        <!-- Scrollbar fina estilo Kairos: sin flechas, pildora violeta translucida -->
        <Style x:Key="KairosScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" CornerRadius="3" Background="#4DA78BFA" Margin="2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="Background" Value="#80A78BFA"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="T" Property="Background" Value="#B35B5BF5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KairosScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource KairosScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root"
            Background="#33141422"
            CornerRadius="20"
            BorderBrush="#26A78BFA" BorderThickness="1"
            Margin="16"
            RenderTransformOrigin="0.5,1">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="48" ShadowDepth="12" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Caja de busqueda -->
            <Border Grid.Row="0" Background="#1AFFFFFF" CornerRadius="12"
                    BorderBrush="#1FFFFFFF" BorderThickness="0.5" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="16" Foreground="#B3A78BFA"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox x:Name="Search" Grid.Column="1"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextPrimary}"
                             CaretBrush="{StaticResource AccentSoft}"
                             FontFamily="Inter, Segoe UI" FontSize="15"
                             VerticalAlignment="Center"
                             TextChanged="Search_TextChanged"
                             PreviewKeyDown="Search_PreviewKeyDown"/>
                </Grid>
            </Border>

            <!-- Etiqueta seccion -->
            <TextBlock x:Name="SectionLabel" Grid.Row="1" Text="Todas las aplicaciones"
                       Foreground="{StaticResource TextMuted}"
                       FontFamily="Inter, Segoe UI" FontSize="11"
                       FontWeight="SemiBold" Margin="4,18,0,10"
                       TextOptions.TextFormattingMode="Ideal"/>

            <!-- Grid de apps -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource KairosScrollBar}"/>
                </ScrollViewer.Resources>
                <ItemsControl x:Name="AppsGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="92" Height="92" Margin="4"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand"
                                    Click="AppButton_Click" Tag="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="14" Background="Transparent" Padding="6">
                                            <StackPanel VerticalAlignment="Center">
                                                <Image Source="{Binding Icon}" Width="40" Height="40"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#E6F4F4FF"
                                                           FontFamily="Inter, Segoe UI" FontSize="11"
                                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           MaxWidth="80" Margin="0,8,0,0"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1F5B5BF5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Fila de energia -->
            <Border Grid.Row="3" Background="#14FFFFFF" CornerRadius="12" Margin="0,16,0,0" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16" Foreground="#B3A78BFA" VerticalAlignment="Center"/>
                        <TextBlock x:Name="UserName" Text="Kairos"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="Inter, Segoe UI" FontSize="13"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Width="40" Height="40" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" ToolTip="Bloquear"
                            Click="Lock_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" CornerRadius="10" Background="Transparent">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16" Foreground="#D9F4F4FF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="B" Property="Background" Value="#1F5B5BF5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2" Width="40" Height="40" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" ToolTip="Reiniciar"
                            Click="Restart_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" CornerRadius="10" Background="Transparent">
                                    <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16" Foreground="#D9F4F4FF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="B" Property="Background" Value="#1F5B5BF5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="3" Width="40" Height="40" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" ToolTip="Apagar"
                            Click="Shutdown_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" CornerRadius="10" Background="Transparent">
                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16" Foreground="#F4A78BFA"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="B" Property="Background" Value="#33F55B5B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
