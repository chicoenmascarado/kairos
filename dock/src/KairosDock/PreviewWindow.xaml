<Window x:Class="KairosDock.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kairos Preview"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#12121C"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="248" Height="172"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI">

    <!-- NOT layered (AllowsTransparency=False): the DWM live thumbnail only
         composites into non-layered windows. The close (X) lives in the header,
         OUTSIDE the thumbnail rect, so the DWM composition never covers it. -->
    <Border BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#66A78BFA" Offset="0" />
                <GradientStop Color="#335B5BF5" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Grid Margin="8,5,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: title + close button -->
            <Grid Grid.Row="0" Margin="2,0,0,5">
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Margin="0,0,26,0" Text="" />
                <Border x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="18" Height="18" CornerRadius="9" Background="#22FFFFFF" Cursor="Hand"
                        ToolTip="Cerrar">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- The live preview is painted here by DWM. -->
            <Border x:Name="ThumbArea" Grid.Row="1" Background="#06000000" />
        </Grid>
    </Border>
</Window>
