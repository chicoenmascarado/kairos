<Application x:Class="KairosDock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Kairos identity palette. Centralised so the whole dock stays on-brand. -->
        <Color x:Key="KairosBaseColor">#FF08080F</Color>
        <Color x:Key="KairosPanelColor">#FF0D0D1A</Color>
        <Color x:Key="KairosAccentColor">#FF5B5BF5</Color>
        <Color x:Key="KairosSoftPurpleColor">#FFA78BFA</Color>

        <SolidColorBrush x:Key="KairosAccentBrush" Color="{StaticResource KairosAccentColor}" />
        <SolidColorBrush x:Key="KairosSoftPurpleBrush" Color="{StaticResource KairosSoftPurpleColor}" />
    </Application.Resources>
</Application>
