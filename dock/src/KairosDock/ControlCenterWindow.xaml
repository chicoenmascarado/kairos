<Window x:Class="KairosDock.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kairos Control Center"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="296"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Custom thin, rounded, violet-tinted scrollbar (no arrow buttons). -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="6" CornerRadius="3" Margin="1,0"
                                                        Background="#4DA78BFA" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apple-style thin slider: rounded track + glowing violet thumb. -->
        <Style x:Key="CCSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" Background="#33FFFFFF" />
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#FF5B5BF5" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer margin leaves room for the drop shadow. RenderTransform drives the
         Apple-style open animation (slide-up + subtle scale). -->
    <Border x:Name="RootCard" Margin="16" CornerRadius="22" BorderThickness="1"
            RenderTransformOrigin="0.5,1">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="CardSlide" Y="0" />
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F2161622" Offset="0" />
                <GradientStop Color="#F50C0C16" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#55A78BFA" Offset="0" />
                <GradientStop Color="#14FFFFFF" Offset="0.5" />
                <GradientStop Color="#205B5BF5" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="38" ShadowDepth="10" Direction="270" Opacity="0.6" Color="#FF05050A" />
        </Border.Effect>

        <StackPanel Margin="16,14,16,16">

            <!-- Header: battery + clock -->
            <Grid>
                <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="BatteryGlyph" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="#FFA78BFA" Text="&#xE83F;" VerticalAlignment="Center" />
                    <TextBlock x:Name="BatteryText" Foreground="White" FontSize="15" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center" Text="—" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right">
                    <TextBlock x:Name="TimeText" Foreground="White" FontSize="15" FontWeight="SemiBold"
                               TextAlignment="Right" Text="--:--" />
                    <TextBlock x:Name="DateText" Foreground="#FFA78BFA" FontSize="10"
                               TextAlignment="Right" Text="" />
                </StackPanel>
            </Grid>

            <!-- Volume -->
            <Border Background="#14FFFFFF" CornerRadius="14" Padding="12,8" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White"
                               Text="&#xE767;" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Slider Grid.Column="1" x:Name="VolumeSlider" Style="{StaticResource CCSlider}" />
                </Grid>
            </Border>

            <!-- Brightness (hidden when unavailable) -->
            <Border x:Name="BrightnessCard" Background="#14FFFFFF" CornerRadius="14" Padding="12,8" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White"
                               Text="&#xE706;" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Slider Grid.Column="1" x:Name="BrightnessSlider" Style="{StaticResource CCSlider}" />
                </Grid>
            </Border>

            <!-- Quick toggles (dark mode / Wi-Fi / Bluetooth) -->
            <UniformGrid x:Name="TogglesRow" Columns="3" Margin="0,12,0,0" />

            <!-- Media: now-playing title + transport (prev / play-pause / next) -->
            <Border Background="#14FFFFFF" CornerRadius="14" Padding="6,6" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock x:Name="MediaTitle" Foreground="White" FontSize="11" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="6,0,6,5" Visibility="Collapsed" />
                    <StackPanel x:Name="MediaButtons" Orientation="Horizontal" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Quick action: Task Manager -->
            <Border x:Name="TaskMgrButton" Background="#14FFFFFF" CornerRadius="14" Padding="12,9"
                    Margin="0,10,0,0" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White"
                               Text="&#xE9D5;" VerticalAlignment="Center" />
                    <TextBlock Text="Administrador de tareas" Foreground="White" FontSize="13"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- System tray (notification area) -->
            <TextBlock x:Name="TrayHeader" Text="Bandeja del sistema" Foreground="#99FFFFFF"
                       FontSize="11" FontWeight="SemiBold" Margin="4,16,0,8" />
            <Border x:Name="TrayCard" Background="#14FFFFFF" CornerRadius="14" Padding="10,8">
                <WrapPanel x:Name="TrayList" />
            </Border>
        </StackPanel>
    </Border>
</Window>
